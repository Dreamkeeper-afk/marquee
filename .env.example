# ---- Marquee settings ----
# Copy this file to .env and fill in the first three.

# Your Plex server's address (on your network)
PLEX_URL=http://192.168.1.20:32400

# Your Plex token - any movie > ... > Get Info > View XML > copy what's after "X-Plex-Token=" at the end of the address
PLEX_TOKEN=

# The https:// address people will open Marquee at (Tailscale Funnel, Cloudflare Tunnel, or your own domain)
PUBLIC_URL=https://marquee.example.com

# ---- optional ----
# PORT=8484
# HOST=127.0.0.1
# DATA_DIR=./data
# REVIEW_TIME=24-48 hours
# BLOCK_ANIME=false
# OLLAMA_URL=http://localhost:11434
# EMBED_MODEL=nomic-embed-text
# ALERT_WEBHOOK=https://discord.com/api/webhooks/...
